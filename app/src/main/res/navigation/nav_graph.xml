<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.nasbus.app.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.nasbus.app.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.nasbus.app.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_routeMap"
            app:destination="@id/routeMapFragment" />
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_home_to_routeDetail"
            app:destination="@id/routeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.nasbus.app.ui.schedule.ScheduleFragment"
        android:label="Schedules"
        tools:layout="@layout/fragment_schedule">
        <action
            android:id="@+id/action_schedule_to_routeDetail"
            app:destination="@id/routeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.nasbus.app.ui.account.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account">
        <action
            android:id="@+id/action_account_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/routeDetailFragment"
        android:name="com.nasbus.app.ui.routedetail.RouteDetailFragment"
        android:label="Route Detail"
        tools:layout="@layout/fragment_route_detail">
        <argument
            android:name="routeId"
            app:argType="integer"
            android:defaultValue="1" />
        <argument
            android:name="fromStopName"
            app:argType="string" />
        <argument
            android:name="toStopName"
            app:argType="string" />
        <action
            android:id="@+id/action_routeDetail_to_routeMap"
            app:destination="@id/routeMapFragment" />
    </fragment>

    <fragment
        android:id="@+id/routeMapFragment"
        android:name="com.nasbus.app.ui.map.RouteMapFragment"
        android:label="Route Map"
        tools:layout="@layout/fragment_route_map">
        <argument
            android:name="routeId"
            app:argType="integer"
            android:defaultValue="1" />
        <argument
            android:name="fromStopName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="toStopName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

</navigation>